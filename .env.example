# Server
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=true

# PostgreSQL leveres normalt af hostingudbyderen
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_POOL_SIZE=5
# Brug kun no-verify, hvis hostingudbyderen udtrykkeligt kræver det
# DATABASE_SSL=no-verify

# Første administrator oprettes kun, når databasen er tom
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=SKIFT-TIL-EN-LANG-UNIK-ADGANGSKODE

# Login-sessioner
SESSION_TTL_HOURS=8

# Permanent disk til bagagebilleder og kvitteringer
UPLOAD_DIR=/data/uploads

# Valgfrit: ekstra tilladte adresser, adskilt med komma
# ALLOWED_ORIGINS=https://midlertidig-adresse.example
